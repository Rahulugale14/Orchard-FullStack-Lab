{
  "openapi": "3.1.0",
  "info": {
    "title": "Orchard Quality Lab API",
    "version": "1.0.0",
    "description": "Same-origin REST API for UI, API, and SQLite database automation practice. Synthetic values only; no payments or emails are processed."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as the Orchard website"
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Catalog"
    },
    {
      "name": "Authentication"
    },
    {
      "name": "Cart"
    },
    {
      "name": "Wishlist"
    },
    {
      "name": "Orders"
    },
    {
      "name": "Returns"
    },
    {
      "name": "Support"
    },
    {
      "name": "QA"
    }
  ],
  "components": {
    "securitySchemes": {
      "orchardSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "orchard_sid",
        "description": "HttpOnly same-site session cookie set by signup/signin."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "firstName",
          "lastName",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "sku",
          "name",
          "category",
          "description",
          "priceCents",
          "price",
          "image",
          "tag",
          "stock"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "image": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Shipping": {
        "type": "object",
        "required": [
          "fullName",
          "address",
          "city",
          "zip",
          "country"
        ],
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "string",
            "minLength": 1
          },
          "city": {
            "type": "string",
            "minLength": 1
          },
          "zip": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "email",
          "password",
          "acceptTerms"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1
          },
          "lastName": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "acceptTerms": {
            "const": true
          }
        }
      },
      "CartItemRequest": {
        "type": "object",
        "required": [
          "productId"
        ],
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 1
          },
          "color": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          }
        }
      },
      "OrderRequest": {
        "type": "object",
        "required": [
          "shipping",
          "paymentMethod"
        ],
        "properties": {
          "shipping": {
            "$ref": "#/components/schemas/Shipping"
          },
          "paymentMethod": {
            "type": "string",
            "enum": [
              "Credit Card",
              "Orchard Pay",
              "Pay on Delivery"
            ]
          }
        }
      },
      "SupportRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "message"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "orderId": {
            "type": "string",
            "pattern": "^ORD-[A-Z0-9]{6}$"
          },
          "message": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Request validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Requested resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check app and SQLite health",
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "List, search, filter, sort and paginate products",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "featured",
                "price-asc",
                "price-desc",
                "name"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24,
              "default": 8
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Catalog results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "pagination": {
                      "type": "object"
                    },
                    "filters": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Get product detail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Product"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/auth/signup": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Create an account and sign in",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created and session cookie set"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "409": {
            "description": "Email already exists"
          }
        }
      }
    },
    "/api/auth/signin": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Sign in and create session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  },
                  "rememberMe": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated and session cookie set"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/auth/signout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "End the current session",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session ended and cookie expired"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get the current signed-in user",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/auth/password/forgot": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Prepare a demo password reset token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generic response; QA mode may include demoResetToken"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/auth/password/reset": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Apply a demo password reset token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "token",
                  "newPassword"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "token": {
                    "type": "string"
                  },
                  "newPassword": {
                    "type": "string",
                    "minLength": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset completed"
          },
          "400": {
            "description": "Invalid or expired token"
          }
        }
      }
    },
    "/api/cart": {
      "get": {
        "tags": [
          "Cart"
        ],
        "summary": "Read cart, count and subtotal",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cart response"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/cart/items": {
      "post": {
        "tags": [
          "Cart"
        ],
        "summary": "Add product to cart",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CartItemRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Updated cart"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Insufficient stock"
          }
        }
      }
    },
    "/api/cart/items/{cartItemId}": {
      "patch": {
        "tags": [
          "Cart"
        ],
        "summary": "Change cart quantity",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "parameters": [
          {
            "name": "cartItemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "quantity"
                ],
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated cart"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Cart"
        ],
        "summary": "Remove cart item",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "parameters": [
          {
            "name": "cartItemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated cart"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/wishlist": {
      "get": {
        "tags": [
          "Wishlist"
        ],
        "summary": "List saved products",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Saved products"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/wishlist/{productId}": {
      "post": {
        "tags": [
          "Wishlist"
        ],
        "summary": "Save product to wishlist",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Saved"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Wishlist"
        ],
        "summary": "Remove product from wishlist",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removed"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "List signed-in user orders",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Order history"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Create order atomically from cart; decrement stock and clear cart",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "description": "Not authenticated"
          },
          "409": {
            "description": "Empty cart or insufficient stock"
          }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Get order and line item detail",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^ORD-[A-Z0-9]{6}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order details"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/orders/{id}/status": {
      "patch": {
        "tags": [
          "Orders"
        ],
        "summary": "Advance Processing \u2192 Shipped \u2192 Delivered",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order status advanced"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Invalid transition"
          }
        }
      }
    },
    "/api/orders/{id}/cancel": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Cancel processing order and restore stock",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order cancelled"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Order cannot be cancelled"
          }
        }
      }
    },
    "/api/returns": {
      "get": {
        "tags": [
          "Returns"
        ],
        "summary": "List return requests",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Return requests"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      },
      "post": {
        "tags": [
          "Returns"
        ],
        "summary": "Create return request",
        "security": [
          {
            "orchardSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "orderId",
                  "reason"
                ],
                "properties": {
                  "orderId": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "details": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Return request created"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Order not returnable"
          }
        }
      }
    },
    "/api/support": {
      "post": {
        "tags": [
          "Support"
        ],
        "summary": "Create support ticket",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupportRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ticket ID and status"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/qa/db-summary": {
      "get": {
        "tags": [
          "QA"
        ],
        "summary": "Read safe aggregate DB table counts (local QA mode only)",
        "responses": {
          "200": {
            "description": "Aggregate counts only"
          },
          "404": {
            "description": "QA inspection endpoint disabled"
          }
        }
      }
    }
  }
}
